  "cases": [
    {
      "id": "current-exact-two-principal-choice",
      "description": "Two exact current affirmations cover the bounded synthetic request.",
      "operations": [],
      "expected_status": "READY_FOR_EXTERNAL_CHECKS",
      "expected_reason": "STRUCTURAL_CHECKS_PASSED"
    },
    {
      "id": "silence-does-not-affirm",
      "description": "An absent principal expression blocks rather than creating consent or refusal.",
      "operations": [
        {
          "op": "replace",
          "path": "/choices",
          "value": []
        },
        {
          "op": "replace",
          "path": "/current_heads",
          "value": []
        }
      ],
      "expected_status": "BLOCKED",
      "expected_reason": "MISSING_AFFIRMATION"
    },
    {
      "id": "explicit-refusal-is-complete",
      "description": "A refusal blocks the exact proposal without becoming an adverse event.",
      "operations": [
        {
          "op": "replace",
          "path": "/choices/0/kind",
          "value": "REFUSE"
        },
        {
          "op": "replace",
